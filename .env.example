# Magnetic Funnels Hub v2, variáveis de ambiente (Vercel > Settings > Environment Variables)
# Lucas: cole o valor de cada uma. Sem valor, a conta aparece no painel como "aguardando credencial".
# PIT = Private Integration Token da location no HighLevel (Settings > Private Integrations).

# Plataforma
HUB_ADMIN_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# HighLevel, um PIT por location
HL_PIT_MAGNETIC_FUNNELS_US=
HL_PIT_COMUNIDADE_MAGNETIC_FLOWS=
HL_PIT_MAGNETIC_FLOWS_COMMUNITY=
HL_PIT_SUMTHIN_DIFFERENT=
HL_PIT_THE_BAR_AESTHETICS=
HL_PIT_MUSCATINE_TREE_SERVICE=
HL_PIT_QC_AESTHETICS=
HL_PIT_QC_HOME_RENOVATION=
HL_PIT_QC_HOUSE_CLEANING=
HL_PIT_QC_ELECTRIC=
HL_PIT_QC_LANDSCAPING=

# Ponte dos agentes OpenBot e modo agência (2026-11-27)
# OPENBOT_AGENCY_CLIENT_ID/SECRET = client keys do app Marketplace da agência.
# O token de empresa (OAuth) fica no Supabase, public.agencia_conexao.
OPENBOT_AGENT_KEY=
OPENBOT_AGENCY_CLIENT_ID=
OPENBOT_AGENCY_CLIENT_SECRET=

# Fontes próprias
FTQC_API_KEY=
FAM_SOURCE_KEY=

# GA4, ID da propriedade por site (Fase 2, tráfego)
GA4_SERVICE_ACCOUNT_JSON=
GA4_MAGNETIC_FUNNELS_US=
GA4_SUMTHIN_DIFFERENT=
GA4_THE_BAR_AESTHETICS=
GA4_FRESH_AIR_MOVEMENT=
GA4_MUSCATINE_TREE_SERVICE=
GA4_QC_AESTHETICS=
GA4_QC_HOME_RENOVATION=
GA4_QC_HOUSE_CLEANING=
